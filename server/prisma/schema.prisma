generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String          @id @db.VarChar(255)
  email               String          @unique @db.VarChar(255)
  passwordHash        String          @map("password_hash")
  fullName            String?         @map("full_name") @db.VarChar(255)
  role                String          @default("user") @db.VarChar(50)
  accountType         String          @default("event_planner") @map("account_type") @db.VarChar(50)
  companyName         String?         @map("company_name") @db.VarChar(255)
  emailVerified       Boolean         @default(false) @map("email_verified")
  otp                 String?         @db.VarChar(255)
  otpExpires          BigInt?         @map("otp_expires")
  otpAttempts         Int             @default(0) @map("otp_attempts")
  failedLoginAttempts Int             @default(0) @map("failed_login_attempts")
  lockoutUntil        BigInt          @default(0) @map("lockout_until")
  resetToken          String?         @map("reset_token") @db.VarChar(255)
  resetTokenExpires   BigInt?         @map("reset_token_expires")
  tokenVersion        Int             @default(0) @map("token_version")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  companyProfile      CompanyProfile?
  subscription        Subscription?
  vendor              Vendor?

  @@index([email])
  @@map("users")
}

model CompanyProfile {
  id String @id @db.VarChar(255)

  userId String @unique @map("user_id") @db.VarChar(255)
  email  String @db.VarChar(255)

  fullName    String @map("full_name") @db.VarChar(255)
  companyName String @map("company_name") @db.VarChar(255)
  industry    String @db.VarChar(150)
  location    String @db.VarChar(255)

  businessEmail            String @map("business_email") @db.VarChar(255)
  businessPhoneCountryCode String @map("business_phone_country_code") @db.VarChar(10)
  businessPhoneNumber      String @map("business_phone_number") @db.VarChar(30)

  website     String? @db.VarChar(500)
  foundedYear Int?    @map("founded_year")
  companySize String? @map("company_size") @db.VarChar(100)

  aboutCompany String @map("about_company")
  companyType  String @map("company_type") @db.VarChar(100)

  companyLinkedin String? @map("company_linkedin") @db.VarChar(500)
  instagram       String? @db.VarChar(500)

  services Json @default("[]")

  logoUrl  String? @map("logo_url")
  logoCrop Json    @default("{}") @map("logo_crop")

  bannerUrl  String? @map("banner_url")
  bannerCrop Json    @default("{}") @map("banner_crop")

  founderName  String? @map("founder_name") @db.VarChar(255)
  founderTitle String? @map("founder_title") @db.VarChar(255)
  founderEmail String? @map("founder_email") @db.VarChar(255)

  founderPhoneCountryCode String? @map("founder_phone_country_code") @db.VarChar(10)
  founderPhoneNumber      String? @map("founder_phone_number") @db.VarChar(30)

  founderLinkedin String? @map("founder_linkedin") @db.VarChar(500)
  founderBio      String? @map("founder_bio")

  founderPhotoUrl  String? @map("founder_photo_url")
  founderPhotoCrop Json    @default("{}") @map("founder_photo_crop")

  teamMembers Json @default("[]") @map("team_members")

  profileCompletion Int     @default(0) @map("profile_completion")
  isVerified        Boolean @default(false) @map("is_verified")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyName])
  @@index([industry])
  @@index([location])
  @@map("company_profiles")
}

model Vendor {
  id               String   @id @db.VarChar(255)
  userId           String?  @unique @map("user_id") @db.VarChar(255)
  name             String   @db.VarChar(255)
  category         String?  @db.VarChar(100)
  city             String?  @db.VarChar(100)
  rating           Decimal  @default(5.0) @db.Decimal(3, 2)
  reviews          Int      @default(0)
  price            String?  @db.VarChar(100)
  priceValue       Decimal  @default(0) @map("price_value") @db.Decimal(12, 2)
  description      String?
  services         Json     @default("[]")
  serviceOfferings Json     @default("[]") @map("service_offerings")
  gallery          Json     @default("[]")
  contact          Json     @default("{}")
  responseTime     String?  @map("response_time") @db.VarChar(100)
  availability     String?  @db.VarChar(100)
  verified         Boolean  @default(false)
  isAvailable      Boolean  @default(true) @map("is_available")
  match            Int      @default(90)
  image            String?
  accent           String?  @db.VarChar(255)
  review           String?
  blockedDates     Json     @default("[]") @map("blocked_dates")
  commissionRate   Decimal  @default(8.0) @map("commission_rate") @db.Decimal(5, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User?    @relation(fields: [userId], references: [id])

  @@index([category])
  @@index([city])
  @@index([isAvailable])
  @@index([rating])
  @@map("vendors")
}

model Booking {
  id               String    @id @db.VarChar(255)
  vendorId         String    @map("vendor_id") @db.VarChar(255)
  vendorName       String?   @map("vendor_name") @db.VarChar(255)
  category         String?   @db.VarChar(100)
  city             String?   @db.VarChar(100)
  userId           String?   @map("user_id") @db.VarChar(255)
  clientName       String?   @map("client_name") @db.VarChar(255)
  clientEmail      String?   @map("client_email") @db.VarChar(255)
  clientPhone      String?   @map("client_phone") @db.VarChar(255)
  plannerName      String?   @map("planner_name") @db.VarChar(255)
  plannerEmail     String?   @map("planner_email") @db.VarChar(255)
  plannerPhone     String?   @map("planner_phone") @db.VarChar(255)
  eventType        String?   @map("event_type") @db.VarChar(255)
  eventDate        DateTime? @map("event_date") @db.Timestamptz(6)
  guestCount       Int       @default(0) @map("guest_count")
  budget           String?   @db.VarChar(100)
  status           String    @default("Pending") @db.VarChar(50)
  paidAmount       Decimal   @default(0) @map("paid_amount") @db.Decimal(12, 2)
  commissionAmount Decimal   @default(0) @map("commission_amount") @db.Decimal(12, 2)
  commissionStatus String    @default("none") @map("commission_status") @db.VarChar(50)
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([vendorId])
  @@index([userId])
  @@index([status])
  @@index([vendorId, status])
  @@map("bookings")
}

model Inquiry {
  id        String   @id @db.VarChar(255)
  vendorId  String?  @map("vendor_id") @db.VarChar(255)
  userId    String?  @map("user_id") @db.VarChar(255)
  name      String?  @db.VarChar(255)
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(255)
  message   String?
  eventType String?  @map("event_type") @db.VarChar(100)
  status    String   @default("New") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status])
  @@map("inquiries")
}

model Transaction {
  id                String    @id @db.VarChar(255)
  userId            String    @map("user_id") @db.VarChar(255)
  vendorId          String?   @map("vendor_id") @db.VarChar(255)
  vendor            String?   @db.VarChar(255)
  amount            Decimal   @db.Decimal(12, 2)
  type              String    @default("expense") @db.VarChar(50)
  category          String?   @db.VarChar(100)
  description       String?
  notes             String?
  date              DateTime  @default(now()) @db.Timestamptz(6)
  dueDate           DateTime? @map("due_date") @db.Timestamptz(6)
  status            String    @default("Pending") @db.VarChar(50)
  invoice           String?   @db.VarChar(100)
  method            String?   @db.VarChar(50)
  razorpayOrderId   String?   @map("razorpay_order_id") @db.VarChar(255)
  razorpayPaymentId String?   @map("razorpay_payment_id") @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@map("transactions")
}

model Message {
  id         String   @id @db.VarChar(255)
  vendorId   String   @map("vendor_id") @db.VarChar(255)
  vendorName String?  @map("vendor_name") @db.VarChar(255)
  userId     String   @map("user_id") @db.VarChar(255)
  userName   String?  @map("user_name") @db.VarChar(255)
  sender     String   @db.VarChar(50)
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([vendorId, userId])
  @@index([userId])
  @@index([vendorId])
  @@map("messages")
}

model Review {
  id          String   @id @db.VarChar(255)
  bookingId   String   @unique @map("booking_id") @db.VarChar(255)
  vendorId    String   @map("vendor_id") @db.VarChar(255)
  userId      String   @map("user_id") @db.VarChar(255)
  plannerName String?  @map("planner_name") @db.VarChar(255)
  rating      Decimal  @db.Decimal(3, 2)
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([vendorId])
  @@map("reviews")
}

model Subscription {
  id             String    @id @db.VarChar(255)
  userId         String    @unique @map("user_id") @db.VarChar(255)
  plan           String    @default("FREE") @db.VarChar(50)
  status         String    @default("ACTIVE") @db.VarChar(50)
  amount         Decimal   @default(0) @db.Decimal(12, 2)
  quota          Int       @default(0)
  usedUnlocks    Int       @default(0) @map("used_unlocks")
  startDate      DateTime  @default(now()) @map("start_date") @db.Timestamptz(6)
  expiryDate     DateTime? @map("expiry_date") @db.Timestamptz(6)
  orderReference String?   @map("order_reference") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model VendorUnlock {
  id             String   @id @db.VarChar(255)
  userId         String   @map("user_id") @db.VarChar(255)
  vendorId       String   @map("vendor_id") @db.VarChar(255)
  subscriptionId String?  @map("subscription_id") @db.VarChar(255)
  unlockedAt     DateTime @default(now()) @map("unlocked_at") @db.Timestamptz(6)

  @@unique([userId, vendorId])
  @@index([userId])
  @@index([vendorId])
  @@map("vendor_unlocks")
}

model PaymentEvent {
  id        String   @id @db.VarChar(255)
  eventId   String   @unique @map("event_id") @db.VarChar(255)
  eventType String   @map("event_type") @db.VarChar(100)
  orderId   String?  @map("order_id") @db.VarChar(255)
  paymentId String?  @map("payment_id") @db.VarChar(255)
  userId    String?  @map("user_id") @db.VarChar(255)
  status    String   @default("processed") @db.VarChar(50)
  payload   Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([paymentId])
  @@index([userId])
  @@map("payment_events")
}
