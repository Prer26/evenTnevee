generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                  String          @id
  email               String          @unique
  passwordHash        String          @map("password_hash")
  fullName            String?         @map("full_name")
  role                String          @default("user")
  accountType         String          @default("event_planner") @map("account_type")
  companyName         String?         @map("company_name")
  emailVerified       Boolean         @default(false) @map("email_verified")
  otp                 String?
  otpExpires          BigInt?         @map("otp_expires")
  otpAttempts         Int             @default(0) @map("otp_attempts")
  failedLoginAttempts Int             @default(0) @map("failed_login_attempts")
  lockoutUntil        BigInt          @default(0) @map("lockout_until")
  resetToken          String?         @map("reset_token")
  resetTokenExpires   BigInt?         @map("reset_token_expires")
  tokenVersion        Int             @default(0) @map("token_version")
  createdAt           DateTime        @default(now()) @map("created_at")
  companyProfile      CompanyProfile?
  subscription        Subscription?
  vendor              Vendor?

  @@index([email])
  @@map("users")
}

model CompanyProfile {
  id String @id

  userId String @unique @map("user_id")
  email  String

  fullName    String @map("full_name")
  companyName String @map("company_name")
  industry    String
  location    String

  businessEmail            String @map("business_email")
  businessPhoneCountryCode String @map("business_phone_country_code")
  businessPhoneNumber      String @map("business_phone_number")

  website     String?
  foundedYear Int?    @map("founded_year")
  companySize String? @map("company_size")

  aboutCompany String
  companyType  String @map("company_type")

  companyLinkedin String? @map("company_linkedin")
  instagram       String?

  services String @default("[]")

  logoUrl  String? @map("logo_url")
  logoCrop String  @default("{}") @map("logo_crop")

  bannerUrl  String? @map("banner_url")
  bannerCrop String  @default("{}") @map("banner_crop")

  founderName  String? @map("founder_name")
  founderTitle String? @map("founder_title")
  founderEmail String? @map("founder_email")

  founderPhoneCountryCode String? @map("founder_phone_country_code")
  founderPhoneNumber      String? @map("founder_phone_number")

  founderLinkedin String? @map("founder_linkedin")
  founderBio      String?

  founderPhotoUrl  String? @map("founder_photo_url")
  founderPhotoCrop String  @default("{}") @map("founder_photo_crop")

  teamMembers String @default("[]") @map("team_members")

  profileCompletion Int     @default(0) @map("profile_completion")
  isVerified        Boolean @default(false) @map("is_verified")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyName])
  @@index([industry])
  @@index([location])
  @@map("company_profiles")
}

model Vendor {
  id               String   @id
  userId           String?  @unique @map("user_id")
  name             String
  category         String?
  city             String?
  rating           Float    @default(5.0)
  reviews          Int      @default(0)
  price            String?
  priceValue       Float    @default(0) @map("price_value")
  description      String?
  services         String   @default("[]")
  serviceOfferings String   @default("[]") @map("service_offerings")
  gallery          String   @default("[]")
  contact          String   @default("{}")
  responseTime     String?  @map("response_time")
  availability     String?
  verified         Boolean  @default(false)
  isAvailable      Boolean  @default(true) @map("is_available")
  match            Int      @default(90)
  image            String?
  accent           String?
  review           String?
  blockedDates     String   @default("[]") @map("blocked_dates")
  commissionRate   Float    @default(8.0) @map("commission_rate")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User?    @relation(fields: [userId], references: [id])

  @@index([category])
  @@index([city])
  @@index([isAvailable])
  @@index([rating])
  @@map("vendors")
}

model Booking {
  id               String    @id
  vendorId         String    @map("vendor_id")
  vendorName       String?   @map("vendor_name")
  category         String?
  city             String?
  userId           String?   @map("user_id")
  clientName       String?   @map("client_name")
  clientEmail      String?   @map("client_email")
  clientPhone      String?   @map("client_phone")
  plannerName      String?   @map("planner_name")
  plannerEmail     String?   @map("planner_email")
  plannerPhone     String?   @map("planner_phone")
  eventType        String?   @map("event_type")
  eventDate        DateTime? @map("event_date")
  guestCount       Int       @default(0) @map("guest_count")
  budget           String?
  status           String    @default("Pending")
  paidAmount       Float     @default(0) @map("paid_amount")
  commissionAmount Float     @default(0) @map("commission_amount")
  commissionStatus String    @default("none") @map("commission_status")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([vendorId])
  @@index([userId])
  @@index([status])
  @@index([vendorId, status])
  @@map("bookings")
}

model Inquiry {
  id        String   @id
  vendorId  String?  @map("vendor_id")
  userId    String?  @map("user_id")
  name      String?
  email     String?
  phone     String?
  message   String?
  eventType String?  @map("event_type")
  status    String   @default("New")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@map("inquiries")
}

model Transaction {
  id                String    @id
  userId            String    @map("user_id")
  vendorId          String?   @map("vendor_id")
  vendor            String?
  amount            Float
  type              String    @default("expense")
  category          String?
  description       String?
  notes             String?
  date              DateTime  @default(now())
  dueDate           DateTime? @map("due_date")
  status            String    @default("Pending")
  invoice           String?
  method            String?
  razorpayOrderId   String?   @map("razorpay_order_id")
  razorpayPaymentId String?   @map("razorpay_payment_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@map("transactions")
}

model Message {
  id         String   @id
  vendorId   String   @map("vendor_id")
  vendorName String?  @map("vendor_name")
  userId     String   @map("user_id")
  userName   String?  @map("user_name")
  sender     String
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([vendorId, userId])
  @@index([userId])
  @@index([vendorId])
  @@map("messages")
}

model Review {
  id          String   @id
  bookingId   String   @unique @map("booking_id")
  vendorId    String   @map("vendor_id")
  userId      String   @map("user_id")
  plannerName String?  @map("planner_name")
  rating      Float
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([vendorId])
  @@map("reviews")
}

model Subscription {
  id             String    @id
  userId         String    @unique @map("user_id")
  plan           String    @default("FREE")
  status         String    @default("ACTIVE")
  amount         Float     @default(0)
  quota          Int       @default(0)
  usedUnlocks    Int       @default(0) @map("used_unlocks")
  startDate      DateTime  @default(now()) @map("start_date")
  expiryDate     DateTime? @map("expiry_date")
  orderReference String?   @map("order_reference")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model VendorUnlock {
  id             String   @id
  userId         String   @map("user_id")
  vendorId       String   @map("vendor_id")
  subscriptionId String?  @map("subscription_id")
  unlockedAt     DateTime @default(now()) @map("unlocked_at")

  @@unique([userId, vendorId])
  @@index([userId])
  @@index([vendorId])
  @@map("vendor_unlocks")
}

model PaymentEvent {
  id        String   @id
  eventId   String   @unique @map("event_id")
  eventType String   @map("event_type")
  orderId   String?  @map("order_id")
  paymentId String?  @map("payment_id")
  userId    String?  @map("user_id")
  status    String   @default("processed")
  payload   String?  @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([paymentId])
  @@index([userId])
  @@map("payment_events")
}
