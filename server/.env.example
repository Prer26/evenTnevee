# Copy this file to .env and fill in your own values.
# Every value below is free — nothing here requires a paid plan.

PORT=4000
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eventneve
# Direct connection string for Prisma migrations/schema introspection (same as DATABASE_URL for local dev)
DIRECT_URL=postgres://postgres:postgres@localhost:5432/eventneve

# development | production. In production, the server REFUSES to start
NODE_ENV=development

# REQUIRED before deploying anywhere real. Any long random string — used to
# sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit this value or reuse it across projects/environments.
JWT_SECRET=replace-this-with-a-long-random-string

# How long a login session stays valid before the user must log in again.
JWT_EXPIRES_IN=7d

# Set to 1 only if deployed behind a reverse proxy/load balancer (Render,
# Fly, nginx, etc.) — makes rate limiting see the real client IP instead of
# the proxy's. Leave unset for local development.
TRUST_PROXY=

# Set to 1 once deployed behind real TLS (almost every host does this
# automatically — Render, Fly, Railway, Vercel, etc. all give you HTTPS for
# free). This redirects any stray http:// request to https:// and enables
# HSTS. Leave unset for local development, since your local server doesn't
# have a certificate.
FORCE_HTTPS=

# --- Email (optional) --------------------------------------------------
# Used for OTP verification codes + password reset links.
# Leave blank during development — emails just get printed to the server
# console instead. To send real emails for free, use a Gmail account:
#   1. Turn on 2-Step Verification on the Gmail account
#   2. Create an "App Password" at https://myaccount.google.com/apppasswords
#   3. Fill these in with that app password (not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- AI (Nova AI chatbot + AI insights) ---------------------------------
# Default provider is Groq — genuinely free tier, no credit card needed.
# Get a free key at https://console.groq.com/keys
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Alternative: run Ollama locally/on your own server for a fully offline,
# always-free option — no API key needed at all:
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=llama3.1

# --- Payments (Razorpay) --------------------------------------------------
# Free to sign up, free to use in TEST mode (fake cards, no real money).
# They only take a cut once you switch to LIVE mode and real payments flow.
#   1. Sign up at https://dashboard.razorpay.com/signup
#   2. Go to Settings > API Keys and generate a TEST mode key pair
#   3. Paste them below
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Persistent Object Storage (S3-compatible) ---------------------------
# Suitable for AWS S3, Cloudflare R2, MinIO, Supabase Storage, Backblaze B2.
# Leave STORAGE_ENDPOINT empty for standard AWS S3.
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Optional custom CDN or public domain URL (e.g., https://cdn.eventneve.com)
STORAGE_PUBLIC_URL=


